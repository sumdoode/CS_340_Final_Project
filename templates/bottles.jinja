{% extends "main.jinja" %}
{% block content %}

<h2>Bottles Table</h2>
<table  border="1" cellpadding="5">
    <thead>
        <tr>
        {% for key in bottles[0].keys() %}
        <th>{{ key }}</th>
        {% endfor %}
		<th>Actions</th>
        </tr>
    </thead>

    <tbody>
    {% for bottle in bottles %}
        <tr>
            {% for key in bottle.keys() %}
            <td>{{bottle[key]}}</td>
            {% endfor %}
			<td>
				<a href="{{ url_for('delete_bottles', bottle_id=bottle['bottle_id']) }}">
					<button class="button delete-btn" onclick="return confirm('Are you sure you want to delete this bottle?')">Delete</button>
				</a>
				<a href="{{ url_for('edit_bottles', bottle_id=bottle['bottle_id']) }}">
					<button class="button edit-btn">Edit</button>
				</a>
			</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<h2>Add a new bottle:</h2>
<form action="{{ url_for('bottles') }}" method="POST">

    <label for="bottle_name">Bottle Name:</label>
    <input type="text" id="bottle_name" name="bottle_name" required>
    <br><br>

    <label for="type">Wine Type:</label>
    <input type="text" id="type" name="type">
    <br><br>

    <label for="volume">Volume:</label>
    <input type="text" id="volume" name="volume" required>
    <br><br>

    <label for="production_yr">Year Produced:</label>
    <input type="text" id="production_yr" name="production_yr">
    <br><br>

    <label for="alc_percent">% Alcohol:</label>
    <input type="text" id="alc_percent" name="alc_percent">
    <br><br>

    <label for="price">Price:</label>
    <input type="text" id="price" name="price">
    <br><br>

    <label for="producer_id">Producer:</label>
    <input type="text" id="producer_id" name="producer_id">
    <br><br>

    <button type="submit" name="add_bottle" class="btn">Add Bottle</button>
</form>

{% endblock %}
